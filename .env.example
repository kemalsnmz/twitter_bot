# ─── ANTHROPIC ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── TWITTER / X API ─────────────────────────────────────
# developer.twitter.com → Projects & Apps → Keys and tokens
TWITTER_BEARER_TOKEN=AAAA...
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...

# ─── TELEGRAM ────────────────────────────────────────────
# @BotFather ile bot oluştur → token al
TELEGRAM_BOT_TOKEN=123456789:AAF...
# Kendi chat ID'n: @userinfobot'a /start yaz
TELEGRAM_CHAT_ID=123456789

# ─── REDDIT ──────────────────────────────────────────────
# reddit.com/prefs/apps → "script" türünde app oluştur
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...

# ─── STABILITY AI ────────────────────────────────────────
# platform.stability.ai → API Keys
STABILITY_API_KEY=sk-...

# ─── TWİKİT (API KEY GEREKMEZ) ───────────────────────────
# Twitter hesabın ile giriş yap, tweet timeline ve arama için
TWITTER_USERNAME=kullanici_adin
TWITTER_EMAIL=email@ornek.com
TWITTER_PASSWORD=sifren

# ─── WEB DASHBOARD ───────────────────────────────────────
# Panele erişim şifresi (boş bırakılırsa auth devre dışı)
DASHBOARD_PASSWORD=
